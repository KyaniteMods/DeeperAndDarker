  "text.config.deeperdarker.option.server.generatedPortalHeight.tooltip": "The height of Otherside portals generated when\ntraveling through dimensions and no portal is\navailable. Making this too large may cause problems.",
  "text.config.deeperdarker.option.server.generatedPortalWidth": "Generated Portal Width",
  "text.config.deeperdarker.option.server.generatedPortalWidth.tooltip": "The width of Otherside portals generated when\ntraveling through dimensions and no portal is\navailable. Making this too large may cause problems.",
